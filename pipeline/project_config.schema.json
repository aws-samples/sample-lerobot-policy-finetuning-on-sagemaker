{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project_config.schema.json",
  "title": "project_config.json \u2014 the only user-edited file of sample-lerobot-policy-finetuning-on-sagemaker",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^_comment": {
      "type": "string"
    }
  },
  "required": [
    "project",
    "dataset",
    "policies",
    "compute",
    "image"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,19}$",
      "description": "Namespaces the stack, the ECR repo, the CodeBuild project and the SSM prefix."
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_comment": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "description": "folder name under datasets/ and the S3 prefix"
        },
        "source": {
          "type": "string",
          "enum": [
            "local",
            "huggingface",
            "s3"
          ]
        },
        "hf_repo_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "hf_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "s3_uri": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^s3://[a-z0-9.-]+/.*$"
        },
        "downscale_height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 120,
          "maximum": 2160
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_comment": {
          "type": "string"
        }
      },
      "properties": {
        "heldout": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "stride": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_comment": {
          "type": "string"
        }
      },
      "required": [
        "instance_type"
      ],
      "properties": {
        "instance_type": {
          "type": "string",
          "pattern": "^(auto|ml\\.[a-z0-9]+\\.[a-z0-9]+)$",
          "description": "SageMaker instance type for the smoke and training jobs, or \"auto\": per policy, the first entry of the registry's hardware.instance_types that the instance rules accept and whose quota (Spot or on-demand, as the policy runs) is above 0 in the job region; no entry with quota stops the run with exit 4 and the quota names to request. --instance-type on the command line overrides it."
        },
        "spot": {
          "type": "boolean"
        },
        "fallback_instance_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ml\\.[a-z0-9]+\\.[a-z0-9]+$"
          }
        },
        "volume_gb": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30
        },
        "runtime_multiplier": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 5.0,
          "description": "runtime cap = overhead + eval + steps / step_rate x multiplier, step_rate from the 200-step smoke (or the registry table). The 3.0 default is headroom for slower policies, checkpoint-heavy runs, eval and publish, not a measured loss (measured runs used well under it, see docs/RESULTS.md); a capped run can always be continued with --resume-from"
        },
        "keep_checkpoints": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "newest complete checkpoints kept on the job volume and in the S3 mirror during and after training (lerobot never deletes any; a pi0-class checkpoint is 16 GB). 0 keeps everything. Smokes always keep their single checkpoint; --resume-from restores whatever was kept."
        },
        "training_plan_arn": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^arn:aws:sagemaker:[a-z]{2}(-gov)?-[a-z]+-[0-9]:[0-9]{12}:training-plan/[A-Za-z0-9._-]+$",
          "description": "A SageMaker Flexible Training Plan (reserved capacity) for the GPU jobs: smoke and training jobs run on the plan instead of on-demand or Spot capacity, so the on-demand quota is not checked for that instance type. null = no plan."
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_comment": {
          "type": "string"
        }
      },
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "integer",
          "minimum": 10
        },
        "reuse": {
          "type": "boolean"
        }
      }
    },
    "policies": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^_comment": {
          "type": "string"
        },
        "^[a-z][a-z0-9_]{1,31}$": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_comment": {
              "type": "string"
            }
          },
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "steps": {
              "type": "integer",
              "minimum": 10
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1
            },
            "horizon_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "save_freq": {
              "type": "integer",
              "minimum": 10
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "overrides": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^--[A-Za-z0-9_.]+(=.*)?$"
              }
            },
            "instance_type": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(auto|ml\\.[a-z0-9]+\\.[a-z0-9]+)$",
              "description": "per-policy override of compute.instance_type; \"auto\" picks the first registry type with quota for this policy"
            },
            "spot": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "accept_licence": {
              "type": "boolean"
            },
            "approval_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "chunk": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "action chunk length; when set it wins over horizon_seconds (the validated ACT run used 24 at 25 fps)"
            },
            "camera": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^observation\\.images?\\.[A-Za-z0-9_]+$",
              "description": "for single-camera policies (VQ-BeT, TD-MPC): the image feature to train on; default = first camera in sorted order"
            },
            "dataset": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^_comment": {
                  "type": "string"
                }
              },
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "description": "folder name under datasets/ and the S3 prefix"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "local",
                    "huggingface",
                    "s3"
                  ]
                },
                "hf_repo_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
                },
                "hf_revision": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "s3_uri": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^s3://[a-z0-9.-]+/.*$"
                },
                "downscale_height": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 120,
                  "maximum": 2160
                }
              },
              "description": "per-policy dataset: any key here overrides the top-level dataset block for this policy (a policy that cannot use the shared dataset gets its own; each distinct dataset is checked and staged once)"
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "description": "free text for your own records (not used by the pipeline)"
            },
            "keep_checkpoints": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "per-policy override of compute.keep_checkpoints"
            },
            "cameras": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "pattern": "^observation\\.images?\\.[A-Za-z0-9_]+$"
              },
              "minItems": 1,
              "description": "train on this subset of the dataset's cameras (a metadata-only view; FastWAM needs a count that divides 448, e.g. 2 of 3)"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_comment": {
          "type": "string"
        }
      },
      "properties": {
        "hf_token": {
          "type": [
            "string",
            "null"
          ],
          "description": "Secrets Manager secret holding a Hugging Face token; null = the default name <project>/hf_token. finetune.sh prompts for the token (hidden input, validated against the Hub) before the first staging job that needs it and stores it; cdk deploy -c hfTokenPrompt=true stores it at deploy time instead (off by default); only the base-weight staging job reads it."
        }
      }
    },
    "extra_job_tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      },
      "maxProperties": 40
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_comment": {
          "type": "string"
        }
      },
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_comment": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "description": "AWS Solution identity (release metadata, not a per-run knob): read by pipeline/solution.py only, from the repo-root file only, for the CloudFormation stack Description and the AWS SDK User-Agent suffix. Optional: without it SDK calls go out unlabelled and cdk/app.py refuses to synthesize until it is given a description of its own.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SO[0-9]+$",
          "description": "Solution id, SO followed by digits; deployment counting matches on the literal '(SO' prefix."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Registered solution name, byte for byte."
        },
        "version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([-.][A-Za-z0-9.-]+)?$",
          "description": "Release version, v followed by major.minor.patch; the same string goes into the stack Description and the User-Agent token."
        }
      }
    }
  }
}
